# ============================================================================
# .env  --  copy to the project root. NEVER commit.
#
# INLINE COMMENTS ARE NOT SAFE HERE. shared/env.py takes everything after the
# first `=` as the value, so `PG_CATALOG_USER=lake_writer   # default` produces
# a username with a sentence in it and a Postgres authentication failure that
# names it back to you. Comments go on their own line.
# ============================================================================

SQLMESH_ENV=dev

PROJECT_ROOT=C:/Users/User/projects/data-engineering-labs/sales_analytics_platform
DATA_DIR=C:/Users/User/projects/data-engineering-labs/sales_analytics_platform/data
WAREHOUSE_DIR=C:/Users/User/projects/data-engineering-labs/sales_analytics_platform/data/warehouse

# Where DuckLake writes its Parquet files. Stored IN the catalog at creation
# by whichever process creates it (ingestion, always). SQLMesh does not pass a
# data path at all -- see the comment in sqlmesh/config.yaml.
PARQUET_PATH=C:/Users/User/projects/data-engineering-labs/sales_analytics_platform/data/warehouse/parquet

# DUCKLAKE_CATALOG_PATH is intentionally absent.
#
# Setting it does not switch backends -- shared/lake.py checks PG_CATALOG_HOST
# first -- but it makes `--check` and any file-existence probe report a path
# nothing reads. Leave it unset while the catalog is PostgreSQL. To fall back
# to the file catalog, unset PG_CATALOG_HOST and set this instead.

LANDING_SKIP_DUPLICATE_FILES=true
LANDING_EVOLVE_SCHEMA=true


# ── PostgreSQL catalog: read by shared/lake.py ──────────────────────────────
#
# Discrete values, because they can go into a DuckDB SECRET and a connection
# string cannot without being parsed. The secret is what keeps the password
# out of DuckLake's attach exceptions.
#
# PG_CATALOG_HOST being set is what selects the PostgreSQL backend. Nothing
# else in the platform changes.

PG_CATALOG_HOST=localhost
PG_CATALOG_PORT=5432
PG_CATALOG_DB=ducklake_catalog

# Default identity for any role with no override below. role="writer"
# (ingestion) has no override and resolves here deliberately.
PG_CATALOG_USER=lake_writer
PG_CATALOG_PASSWORD=CHANGE_ME_lake_writer

# role="reader" -- Streamlit, and any future Superset/Metabase.
PG_CATALOG_USER_READER=bi_reader
PG_CATALOG_PASSWORD_READER=CHANGE_ME_bi_reader

# role="publisher" -- serving/publish.py. Read-only, separate from bi_reader
# so revoking a BI tool does not stop the Power BI export refreshing.
PG_CATALOG_USER_PUBLISHER=publisher
PG_CATALOG_PASSWORD_PUBLISHER=CHANGE_ME_publisher


# ── PostgreSQL catalog: read by DuckDB's postgres extension, for SQLMesh ────
#
# sqlmesh/config.yaml sets `path: postgres:dbname=ducklake_catalog` with no
# user and no password, and libpq fills in the rest from these. That is what
# keeps the credential out of a connection string DuckLake would echo in an
# exception.
#
# WHY THIS DOES NOT COLLIDE WITH THE PG_CATALOG_* BLOCK ABOVE:
# libpq environment variables are consulted only for fields a connection
# string OMITS. shared/lake.py always names its user and password explicitly
# in a SECRET, so ingestion, Streamlit and publish keep their own identities
# regardless of what is set here. These apply to exactly one connection: the
# one SQLMesh's DuckDB process opens.
#
# PGDATABASE is not set. `dbname=` is given explicitly in config.yaml so the
# variable cannot silently redirect the catalog somewhere else.
PGHOST=localhost
PGPORT=5432
PGUSER=sqlmesh_svc
PGPASSWORD=CHANGE_ME_sqlmesh_svc


# ── SQLMesh state: its own database, its own connection ─────────────────────
#
# Read by config.yaml's state_connection via env_var(). SQLMesh makes this
# connection itself through psycopg2, not through DuckDB, so it does not use
# the PG* variables above.
SQLMESH_STATE_DB=sqlmesh_state
SQLMESH_STATE_USER=sqlmesh_svc
SQLMESH_STATE_PASSWORD=CHANGE_ME_sqlmesh_svc

# SQLMESH_STATE_PATH is intentionally absent -- state is in PostgreSQL now.
# Delete any committed sqlmesh_state.db.


# ── Reporting ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-

al_revenue" - COALESCE("prev"."prev_period_revenue", 0) AS "revenue_change", ROUND(("curr"."total_revenue" - COALESCE("prev"."prev_period_revenue", 0)) * 100.0 / NULLIF("prev"."prev_period_revenue", 0), 1) AS "revenue_growth_pct", CASE WHEN "prev"."prev_period_revenue" IS NULL THEN '🆕 New' WHEN "curr"."total_revenue" > "prev"."prev_period_revenue" * 1.2 THEN '🚀 Hot' WHEN "curr"."total_revenue" > "prev"."prev_period_revenue" THEN '📈 Growing' WHEN "curr"."total_revenue" >= "prev"."prev_period_revenue" * 0.9 THEN '➡️ Stable' ELSE '📉 Declining' END AS "trend", ROW_NUMBER() OVER (ORDER BY "curr"."total_revenue" DESC) AS "revenue_rank", CURRENT_TIMESTAMP AS "generated_at" FROM "last_30_days" AS "curr" LEFT JOIN "last_60_to_30_days" AS "prev" ON "curr"."sku" = "prev"."sku" ORDER BY "curr"."total_revenue" DESC LIMIT 20 (base.py:2626)

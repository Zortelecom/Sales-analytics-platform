          {
            "name": "dim_clientsd",
            "source": {
              "expression": [
                "let",
                "    Source = master_parquet_folder,",
                "    #\"Filtered Rows\" = Table.SelectRows(Source, each ([Name] = \"dim_clientsd.parquet\")),",
                "    Content = #\"Filtered Rows\"{0}[Content],",
                "    #\"Imported Parquet\" = Parquet.Document(Content),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Imported Parquet\",{{\"clientsd_key\", type number}, {\"sd_id\", type text}, {\"sd_name\", type text}, {\"region\", type text}, {\"subregion\", type text}, {\"city\", type text}, {\"key_player\", type text}, {\"phone_number\", Int64.Type}, {\"is_destocked\", type logical}, {\"valid_from\", type datetime}, {\"valid_to\", type text}, {\"supervisor_name\", type text}}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Changed Type\",{{\"sd_id\", \"clientsd_id\"}, {\"sd_name\", \"clientsd_name\"}}),",
                "    #\"Text to DateTime\" = Table.TransformColumnTypes(#\"Renamed Columns\",{{\"valid_to\", type datetime}}),",
                "    #\"Extracted Date\" = Table.TransformColumnTypes(#\"Text to DateTime\",{{\"effective_from\", type date}, {\"valid_from\", type date}, {\"valid_to\", type date}})",
                "in",
                "    #\"Extracted Date\""
              ],
              "type": "m"
            }
          }
        ]

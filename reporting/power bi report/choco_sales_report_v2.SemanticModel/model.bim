        "isHidden": true,
        "lineageTag": "5751342a-56ca-428f-8321-dc01d74b559e",
        "partitions": [
          {
            "name": "dim_rls_access",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    // PLACEHOLDER ROWS -- replace with real values before publishing:",
                "    //   user_email    = the Entra ID / AAD sign-in UPN of the actual person",
                "    //                   (must match what USERPRINCIPALNAME() returns once this",
                "    //                   report is published and they sign in)",
                "    //   access_role   = one of \"Sales Rep\", \"Supervisor\", \"Regional Manager\"",
                "    //                   (\"Sales Director\" / \"Data Analyst\" don't need rows here --",
                "    //                   those two roles carry no filter at all, see model.roles)",
                "    //   access_value  = salesperson_id for Sales Rep, supervisor_name for",
                "    //                   Supervisor, region for Regional Manager -- must match the",
                "    //                   spelling actually stored in dim_salespersons / dim_geography",
                "    //                   exactly (this table is not casing-normalized like",
                "    //                   dim_geography is -- add Text.Trim/Text.Proper here too if",
                "    //                   hand-entry drift shows up in practice)",
                "    Source = #table(",
                "        {\"user_email\", \"access_role\", \"access_value\"},",
                "        {",
                "            {\"tokam.albert@tigerbrands.com\", \"Supervisor\", \"Tokam Albert\"},",
                "            {\"aloys.nidakong@tigerbrands.com\", \"Supervisor\", \"Nidakong Aloys\"},",
                "            {\"ducere.ndo-ekoman@tigerbrands.com\", \"Supervisor\", \"Ndo Eko-man\"},",
                "            {\"maguy.lobe@tigerbrands.com\", \"Supervisor\", \"Maguy Lobe\"},",
                "            {\"constant.mbongue@tigerbrands.com\", \"Regional Manager\", \"Centre\"}",
                "        }",
                "    ),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,",
                "        {{\"user_email\", type text}, {\"access_role\", type text}, {\"access_value\", type text}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      },

          },
          {
            "name": "subregion",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isText\":true}"
              }
            ],
            "dataType": "string",
            "lineageTag": "df361c56-5cb5-4288-869c-30b8ae4f7b3f",
            "sourceColumn": "subregion"

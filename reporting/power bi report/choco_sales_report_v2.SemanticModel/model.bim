        "partitions": [
          {
            "name": "fact_sales",
            "source": {
              "expression": [
                "let",
                "    Source = master_parquet_folder,",
                "    #\"Filtered Rows\" = Table.SelectRows(Source, each ([Name] = \"fact_sales.parquet\")),",
                "    Content = #\"Filtered Rows\"{0}[Content],",
                "    #\"Imported Parquet\" = Parquet.Document(Content),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Imported Parquet\",{{\"sales_line_id\", type text}, {\"date_key\", Int64.Type}, {\"sale_date\", type datetime}, {\"sale_year\", Int64.Type}, {\"sale_month\", Int64.Type}, {\"product_key\", type number}, {\"sku\", type text}, {\"product_category\", type text}, {\"salesperson_key\", type number}, {\"salesperson_id\", type text}, {\"salesperson_name\", type text}, {\"region\", type text}, {\"subregion\", type text}, {\"sales_channel\", type text}, {\"supervisor_name\", type text}, {\"clientsd_key\", type number}, {\"clientsd_id\", type text}, {\"quantity\", type number}, {\"unit_price_actual\", Int64.Type}, {\"total_amount\", Int64.Type}, {\"unit_price_standard\", Int64.Type}, {\"unit_weight_actual\", type number}, {\"unit_weight_standard\", type number}, {\"total_weight_kg\", type number}, {\"price_variance_pct\", type number}}),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Changed Type\",{{\"sale_date\", type date}}),",
                "    // supervisor_name is dropped on purpose: it already lives on",
                "    // dim_salespersons and dim_clientsd, and a third copy on the fact would",
                "    // create an ambiguous field for report authors.",
                "    //",
                "    // unit_price_actual / unit_price_standard / unit_weight_actual /",
                "    // unit_weight_standard / price_variance_pct are now KEPT. They were the",
                "    // reason [Weighted Avg Price Variance %] and [# Pricing Exceptions (>10%)]",
                "    // were blocked -- they exist in fact_sales.parquet (the Changed Type step",
                "    // above types them, which would error if they were absent); they were only",
                "    // ever being discarded here, in the model, not upstream in the pipeline.",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Changed Type1\",{\"supervisor_name\"}),",
                "    #\"Replaced Value\" = Table.ReplaceValue(#\"Removed Columns\",\"60-0022B*-\",\"60-0022B-\",Replacer.ReplaceText,{\"sku\"})",
                "in",
                "    #\"Replaced Value\""
              ],
              "type": "m"
            }
          }
        ]
      },

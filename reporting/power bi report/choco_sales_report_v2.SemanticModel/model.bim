    "roles": [
      {
        "name": "Sales Rep",
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "3e51cfd7d7c245948b1d09c8e1dad62c"
          }
        ],
        "modelPermission": "read",
        "tablePermissions": [
          {
            "name": "dim_salespersons",
            "filterExpression": [
              "TRIM(UPPER('dim_salespersons'[salesperson_id])) = TRIM(UPPER(LOOKUPVALUE(",
              "    dim_rls_access[access_value],",
              "    dim_rls_access[user_email], USERPRINCIPALNAME(),",
              "    dim_rls_access[access_role], \"Sales Rep\",",
              "    BLANK()",
              ")))"
            ]
          },
          {
            "name": "dim_clientsd",
            "filterExpression": [
              "VAR CurrentSalespersonId =",
              "    LOOKUPVALUE(",
              "        dim_rls_access[access_value],",
              "        dim_rls_access[user_email], USERPRINCIPALNAME(),",
              "        dim_rls_access[access_role], \"Sales Rep\",",
              "        BLANK()",
              "    )",
              "RETURN",
              "'dim_clientsd'[clientsd_key] IN",
              "CALCULATETABLE(",
              "    VALUES(fact_sales[clientsd_key]),",
              "    REMOVEFILTERS(dim_clientsd),",
              "    TRIM(UPPER(dim_salespersons[salesperson_id])) = TRIM(UPPER(CurrentSalespersonId))",
              ")"
            ]
          }
        ]
      },

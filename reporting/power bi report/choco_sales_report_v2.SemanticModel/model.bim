            "sourceColumn": "[Column]",
            "summarizeBy": "sum",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "d69de491-f9f6-4b18-a701-2f1caa9c2da3",
        "measures": [
          {
            "name": "% Innovation",
            "displayFolder": "Targets",
            "expression": "DIVIDE([Revenue Innovation], [Revenue])",
            "formatString": "#,0.00%;-#,0.00%;#,0.00%",
            "lineageTag": "ade4f173-48fe-4fef-ace4-105be733226f"
          },
          {
            "name": "% Achievement",
            "displayFolder": "Targets",
            "expression": "DIVIDE([Revenue], [Target Amount], 0)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "16e4de19-4975-43f2-a2b8-b1a775f8422a"
          },
          {
            "name": "Avg Monthly Sales",
            "displayFolder": "Revenue",
            "expression": [
              "DIVIDE([Revenue],",
              "\t DISTINCTCOUNT(dim_date[year_month])",
              "\t )"
            ],
            "formatString": "#,0",
            "lineageTag": "0637a8cd-12bc-49de-bd78-118c2dc927d2"
          },
          {
            "name": "MoM Growth %",
            "displayFolder": "Time Intelligence",
            "expression": "DIVIDE([Revenue] - [Revenue Last Month], [Revenue Last Month])",
            "formatString": "#,0.00%;-#,0.00%;#,0.00%",
            "lineageTag": "0347d9b0-1759-4645-878c-af0b5a2a3b4a"
          },
          {
            "name": "Cumulative Product %",
            "expression": [
              "DIVIDE(",
              "    [Cumulative Revenue],",
              "    CALCULATE([Revenue], ALL(dim_products[sku]))",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "128df901-3ee6-4dd5-b0c7-c42f8e60bd1a"
          },
          {
            "name": "Cumulative Product Revenu",
            "displayFolder": "Revenue",
            "expression": [
              "VAR CurrentRank =",
              "    RANKX(",
              "        ALL(dim_products[sku]),",
              "        [Revenue],",
              "        ,",
              "        DESC",
              "    )",
              "RETURN",
              "CALCULATE(",
              "    [Revenue],",
              "    FILTER(",
              "        ALL(dim_products[sku]),",
              "        RANKX(",
              "            ALL(dim_products[sku]),",
              "            [Revenue],",
              "            ,",
              "            DESC",
              "        ) <= CurrentRank",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "3abd0cc2-1c60-4078-889c-488de74b602b"
          },
          {
            "name": "Cumulative Revenue",
            "displayFolder": "Revenue",
            "expression": [
              "CALCULATE(",
              "    [Revenue],",
              "    FILTER(",
              "        ALL(dim_date[date_actual]),",
              "        dim_date[date_actual] <= MAX(dim_date[date_actual])",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "b5734669-5ab4-4dc1-9aa2-bc602c43afbb"
          },
          {
            "name": "Rank Salesperson",
            "expression": [
              "RANKX(",
              "    ALL(dim_salespersons[salesperson_name]),",
              "    [% Achievement],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "2d6cc301-7da2-4fa6-9065-0fa2b96de4c0"
          },
          {
            "name": "Product Rank",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "RANKX(",
              "    ALL(dim_products[sku]),",
              "    [Revenue],",
              "    ,",
              "    DESC",
              ")"
            ],
            "lineageTag": "b4d60c01-b634-4f04-b1ee-c9e7e6a61fe8"
          },
          {
            "name": "Top 80 Percent Product",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "IF([Cumulative Product %] <= 0.8, 1, 0)",
            "lineageTag": "dea72cc4-9a0f-41b1-860e-25ac1ce7ef9e"
          },
          {
            "name": "YoY Growth %",
            "displayFolder": "Time intelligence",
            "expression": [
              "DIVIDE(",
              "    [Revenue] - [Revenue Last Year],",
              "    [Revenue Last Year]",
              ")"
            ],
            "formatString": "#,0.00%;-#,0.00%;#,0.00%",
            "lineageTag": "99db05d9-dfd3-4bf1-a2a6-479b0e19208c"
          },
          {
            "name": "Target Amount",
            "displayFolder": "Targets",
            "expression": [
              "",
              "IF(",
              "    -- Checks if the visual is trying to show individual products",
              "    ISINSCOPE(dim_products[product_name]), ",
              "    BLANK(), -- Hides the target at the product level because targets don't exist there",
              "    CALCULATE(",
              "        SUM(fact_targets[target_amount]),",
              "        TREATAS(",
              "            VALUES(dim_products[product_category]), ",
              "            fact_targets[product_category]",
              "        )",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "lineageTag": "b9d94051-2c7b-40b8-a394-6a19c92dca3c"
          },
          {
            "name": "Total Qty",
            "displayFolder": "Revenue",
            "expression": "SUM(fact_sales[quantity])",
            "formatString": "#,0.0",
            "lineageTag": "c1882dc3-3169-4efb-99cb-57155e19d21d"
          },
          {
            "name": "Target Line",
            "displayFolder": "Targets",
            "expression": "1",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "98e696b1-e08b-4eb0-a857-576ecf8c2ebe"
          },
          {
            "name": "Revenue Last Year",
            "description": [
              "Revenue of the same period year - 1 of the current context",
              ""
            ],
            "displayFolder": "Time Intelligence",
            "expression": [
              "CALCULATE(",
              "    [Revenue],",
              "    SAMEPERIODLASTYEAR(dim_date[date_actual])",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "47a6da25-8832-42d7-8248-959798e2e148"
          },
          {
            "name": "Revenue Last Month",
            "displayFolder": "Time Intelligence",
            "expression": [
              "CALCULATE(",
              "\t[Revenue], ",
              "\tDATEADD(dim_date[date_actual], -1, MONTH)",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "fef360fa-b6a7-480d-a5de-59d4f697c046"
          },
          {
            "name": "Revenue Innovation",
            "displayFolder": "Revenue",
            "expression": [
              "CALCULATE(",
              "    [Revenue],",
              "    dim_products[is_innovation_product] = TRUE()",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "d057200b-a174-4557-8eb9-b055327cdeed"
          },
          {
            "name": "Revenue",
            "displayFolder": "Revenue",
            "expression": "SUM(fact_sales[total_amount])",
            "formatString": "#,0",
            "kpi": {
              "annotations": [
                {
                  "name": "GoalType",
                  "value": "Measure"
                },
                {
                  "name": "KpiStatusType",
                  "value": "Linear"
                },
                {
                  "name": "KpiThresholdType",
                  "value": "Percentage"
                },
                {
                  "name": "KpiThresholdOrdering",
                  "value": "Ascending"
                },
                {
                  "name": "KpiThresholdCount",
                  "value": "2"
                },
                {
                  "name": "KpiThreshold_0",
                  "value": "40"
                },
                {
                  "name": "KpiThreshold_1",
                  "value": "80"
                }
              ],
              "statusExpression": [
                "var x='fact_sales'[Revenue]/'fact_sales'[_Revenue Goal] return",
                "if(ISBLANK(x),BLANK(),",
                "        If(x<0.4,-1,",
                "\t    If(x<0.8,0,1)",
                "    )",
                ")",
                ""
              ],
              "targetExpression": "'fact_sales'[Total Target]",
              "targetFormatString": "#,0"
            },
            "lineageTag": "8e8e3846-0b8d-4769-933d-d6c570ffaf6a"
          },
          {
            "name": "Region Rank (Revenue)",
            "displayFolder": "Geography",
            "expression": [
              "RANKX(",
              "    ALL(dim_geography[region]),",
              "    [Revenue],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "03ec996c-60fc-4cf5-9340-9dd456b024f4"
          },
          {
            "name": "Subregion Rank (Revenue)",
            "displayFolder": "Geography",
            "expression": [
              "RANKX(",
              "    ALL(dim_geography[subregion]),",
              "    [Revenue],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "54b22825-9d36-4f13-a05e-9141fec7f289"
          },
          {
            "name": "# Subregions With Region Conflict",
            "displayFolder": "Geography",
            "expression": [
              "CALCULATE(",
              "    COUNTROWS(dim_geography),",
              "    dim_geography[region_conflict] = TRUE()",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "fd26f3ea-d8cb-4a3e-a96d-c292d39b5740"
          },
          {
            "name": "Sell-In Amount",
            "displayFolder": "Sell-In",
            "expression": "SUM(fact_kp_sd[total_amount])",
            "formatString": "#,0",
            "lineageTag": "14ec1cd7-9897-4fb5-bc37-5e7d85ccab63"
          },
          {
            "name": "Sell-In Qty",
            "displayFolder": "Sell-In",
            "expression": "SUM(fact_kp_sd[quantity])",
            "formatString": "#,0.0",
            "lineageTag": "40995661-6abc-49ac-8262-8f0891aa0059"
          },
          {
            "name": "Sell-Through Ratio",
            "displayFolder": "Sell-In",
            "expression": "DIVIDE([Revenue], [Sell-In Amount])",
            "formatString": "0%",
            "lineageTag": "39f1e105-0185-4299-b666-4f6bc657d23b"
          },
          {
            "name": "KP Rank (Sell-In Amount)",
            "displayFolder": "Sell-In",
            "expression": [
              "RANKX(",
              "    ALL(dim_clientsd[key_player]),",
              "    [Sell-In Amount],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "ae61861a-92f4-4aee-b036-5578cf5f5ece"
          },
          {
            "name": "# Destock Flag Mismatches",
            "description": "Sell-in lines where the source workbook's destocke assertion disagrees with the modelled is_destocked_sd flag.",
            "displayFolder": "Data Quality",
            "expression": [
              "// FIXED. The previous version referenced fact_kp_sd[dim_is_destocked], a column",
              "// that does not exist -- the real column is [is_destocked_sd] -- and compared it",
              "// directly to [source_asserted_destocked], which is TEXT, not boolean. Both",
              "// faults raise at query time, so this measure returned an error, not a number.",
              "//",
              "// Normalise the text side first (supervisors hand-type this upstream, so casing",
              "// and FR/EN spellings both occur), and treat a blank assertion as \"no claim",
              "// made\" rather than a mismatch, so empty source cells do not inflate the count.",
              "COUNTROWS (",
              "    FILTER (",
              "        fact_kp_sd,",
              "        VAR Asserted = TRIM ( UPPER ( fact_kp_sd[source_asserted_destocked] ) )",
              "        VAR AssertedBool = Asserted IN { \"TRUE\", \"1\", \"OUI\", \"VRAI\", \"Y\", \"YES\" }",
              "        VAR Modelled = COALESCE ( fact_kp_sd[is_destocked_sd], FALSE () )",
              "        RETURN",
              "            NOT ISBLANK ( Asserted ) && Asserted <> \"\" && AssertedBool <> Modelled",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "f087e483-e610-4e5e-8b4d-31f95339299f"
          },
          {
            "name": "Destock Mismatch Rate",
            "displayFolder": "Data Quality",
            "expression": "DIVIDE([# Destock Flag Mismatches], COUNTROWS(fact_kp_sd))",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "3e0eba26-3520-4b67-8328-e44e380ead5c"
          },
          {
            "name": "# KP-SD Lines With Unmapped SKU",
            "displayFolder": "Data Quality",
            "expression": [
              "COUNTROWS(",
              "    FILTER(",
              "        fact_kp_sd,",
              "        fact_kp_sd[has_sku_mapping] = FALSE()",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "cb9fdf9b-852d-4166-96ca-9cd56c567991"
          },
          {
            "name": "IMS Anchor Date",
            "description": "Hidden helper. Date the IMS window is anchored on: last date in filter context, capped at today.",
            "displayFolder": "Sell-In\\IMS\\_Window",
            "expression": [
              "// The date the 3-month IMS window is measured back from.",
              "//",
              "// MAX(dim_date[date_actual]) = the last date visible in the current filter",
              "// context, so selecting 2026-03 in the year_month slicer yields the IMS \"as of\"",
              "// March (Dec + Jan + Feb) rather than always the latest one. MIN(..., TODAY())",
              "// stops an *unfiltered* page from anchoring on the end of dim_date -- the date",
              "// dimension runs to the end of the calendar year, so without this guard an",
              "// unsliced card would report a window several months in the future and return",
              "// blank.",
              "MIN ( MAX ( dim_date[date_actual] ), TODAY () )"
            ],
            "formatString": "yyyy-mm-dd",
            "isHidden": true,
            "lineageTag": "23b302f1-9b60-4aad-82ea-1dd06fdc1cdf"
          },
          {
            "name": "IMS Window End",
            "description": "Hidden helper. Inclusive end of the 3-month IMS window.",
            "displayFolder": "Sell-In\\IMS\\_Window",
            "expression": [
              "// Last day of the last COMPLETE month before the anchor.",
              "// Anchor 2026-08-04 -> 2026-07-31.",
              "EOMONTH ( [IMS Anchor Date], -1 )"
            ],
            "formatString": "yyyy-mm-dd",
            "isHidden": true,
            "lineageTag": "6cd0fa4d-5e40-4f73-9e75-61c1f1eb013b"
          },
          {
            "name": "IMS Window Start",
            "description": "Hidden helper. Inclusive start of the 3-month IMS window.",
            "displayFolder": "Sell-In\\IMS\\_Window",
            "expression": [
              "// First day of the window, three months earlier.",
              "// EOMONTH(anchor, -4) is the last day of the month BEFORE the first window",
              "// month, so +1 lands on day 1. Anchor 2026-08-04 -> 2026-05-01.",
              "EOMONTH ( [IMS Anchor Date], -4 ) + 1"
            ],
            "formatString": "yyyy-mm-dd",
            "isHidden": true,
            "lineageTag": "e1fb05a3-947e-4088-82ee-0bb7956f7378"
          },
          {
            "name": "IMS",
            "description": "Average monthly sell-in amount (XAF) over the 3 complete months before the anchor month.",
            "displayFolder": "Sell-In\\IMS",
            "expression": [
              "// IMS -- average monthly sell-in (KP -> SD) over the 3 complete months",
              "// preceding the anchor month. On 2026-08-04 this is (May + Jun + Jul) / 3.",
              "//",
              "// Respects every non-date filter (SD, key player, product, region), so a table",
              "// by dim_clientsd[clientsd_name] gives each SD its own IMS.",
              "VAR SellIn3M =",
              "    CALCULATE (",
              "        [Sell-In Amount],",
              "        // The year_month slicer would otherwise clip the window down to the one",
              "        // selected month. REMOVEFILTERS on the whole table (not just",
              "        // date_actual) is required because the slicer filters dim_date[year_month],",
              "        // a different column from the one DATESBETWEEN re-filters.",
              "        REMOVEFILTERS ( dim_date ),",
              "        DATESBETWEEN ( dim_date[date_actual], [IMS Window Start], [IMS Window End] )",
              "    )",
              "RETURN",
              "    // Fixed divisor of 3, per the business definition. An SD with only 1 or 2",
              "    // months of history is therefore understated on purpose -- use",
              "    // [IMS Coverage (Months)] to spot those rows before acting on them.",
              "    DIVIDE ( SellIn3M, 3 )"
            ],
            "formatString": "#,0",
            "lineageTag": "65b8cdf2-18f5-42a9-8319-4e3ad31e4d80"
          },
          {
            "name": "IMS Qty",
            "description": "Average monthly sell-in quantity (units) over the 3 complete months before the anchor month.",
            "displayFolder": "Sell-In\\IMS",
            "expression": [
              "// Unit-volume twin of [IMS]. Same window, same divisor.",
              "VAR Qty3M =",
              "    CALCULATE (",
              "        [Sell-In Qty],",
              "        REMOVEFILTERS ( dim_date ),",
              "        DATESBETWEEN ( dim_date[date_actual], [IMS Window Start], [IMS Window End] )",
              "    )",
              "RETURN",
              "    DIVIDE ( Qty3M, 3 )"
            ],
            "formatString": "#,0.0",
            "lineageTag": "b5fdebf1-a412-4cf2-9802-7575d98402f8"
          },
          {
            "name": "IMS Window",
            "description": "Text label of the months covered by [IMS], for use as a card subtitle.",
            "displayFolder": "Sell-In\\IMS",
            "expression": [
              "// Human-readable window label for card subtitles, e.g. \"May - Jul 2026\".",
              "// Put this under the IMS card so nobody has to guess which months it covers --",
              "// the number deliberately ignores the month slicer, and that surprises people.",
              "VAR S = [IMS Window Start]",
              "VAR E = [IMS Window End]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( S ) || ISBLANK ( E ),",
              "        BLANK (),",
              "        FORMAT ( S, \"MMM\" ) & \" - \" & FORMAT ( E, \"MMM yyyy\" )",
              "    )"
            ],
            "lineageTag": "dc71106d-ab34-4815-8aab-14263b744f79"
          },
          {
            "name": "IMS Coverage (Months)",
            "description": "Number of the 3 IMS window months with at least one sell-in line. Below 3 means the IMS is diluted.",
            "displayFolder": "Sell-In\\IMS",
            "expression": [
              "// How many of the 3 window months actually contain sell-in rows for the current",
              "// SD / product / region selection. 3 = trustworthy. 1 or 2 = the SD is new or",
              "// dormant and its IMS is diluted by the fixed /3 divisor.",
              "CALCULATE (",
              "    COUNTROWS ( SUMMARIZE ( fact_kp_sd, dim_date[year_month] ) ),",
              "    REMOVEFILTERS ( dim_date ),",
              "    DATESBETWEEN ( dim_date[date_actual], [IMS Window Start], [IMS Window End] )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "5caba3e1-bffb-41d6-b69e-6805e8ad5a44"
          },
          {
            "name": "Sell-In vs IMS %",
            "description": "Sell-In Amount in the selected period divided by IMS. 100% = ordering at the normal 3-month rhythm.",
            "displayFolder": "Sell-In\\IMS",
            "expression": [
              "// Current-period sell-in against the SD's own 3-month running average.",
              "// > 100% = ordering above its normal rhythm (promo, restock, or over-ordering)",
              "// <  80% = ordering below it (destockage in progress, or losing the SD)",
              "DIVIDE ( [Sell-In Amount], [IMS] )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "fc3b3b6e-c7a8-4d39-baee-57b1e5a3bafe"
          },
          {
            "name": "IMS Trend %",
            "description": "IMS of the current 3-month window vs. the preceding 3-month window.",
            "displayFolder": "Sell-In\\IMS",
            "expression": [
              "// This IMS window vs. the 3 months before it -- i.e. (May-Jul) vs (Feb-Apr).",
              "// Slower-moving and less noisy than MoM growth on raw sell-in.",
              "VAR PriorWindowEnd   = EOMONTH ( [IMS Window Start], -1 )",
              "VAR PriorWindowStart = EOMONTH ( [IMS Window Start], -4 ) + 1",
              "VAR PriorIMS =",
              "    DIVIDE (",
              "        CALCULATE (",
              "            [Sell-In Amount],",
              "            REMOVEFILTERS ( dim_date ),",
              "            DATESBETWEEN ( dim_date[date_actual], PriorWindowStart, PriorWindowEnd )",
              "        ),",
              "        3",
              "    )",
              "RETURN",
              "    DIVIDE ( [IMS] - PriorIMS, PriorIMS )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "82e2c941-da54-4e45-ae08-8eea6df3627f"
          },
          {
            "name": "Month Pace %",
            "description": "Share of the selected period elapsed as of today. Calendar days, not selling days.",
            "displayFolder": "Pace & Risk",
            "expression": [
              "// Fraction of the period in filter context that has already elapsed today.",
              "// A fully past period returns 100%, a future period 0%.",
              "VAR PeriodStart = MIN ( dim_date[date_actual] )",
              "VAR PeriodEnd   = MAX ( dim_date[date_actual] )",
              "VAR DaysTotal   = DATEDIFF ( PeriodStart, PeriodEnd, DAY ) + 1",
              "VAR DaysElapsed =",
              "    MAX ( 0, MIN ( DATEDIFF ( PeriodStart, TODAY (), DAY ) + 1, DaysTotal ) )",
              "RETURN",
              "    DIVIDE ( DaysElapsed, DaysTotal )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "b2ed1afe-55aa-444c-9f94-094cf6106ec1"
          },
          {
            "name": "Pace-Adjusted Target",
            "description": "Target Amount pro-rated by the share of the period elapsed.",
            "displayFolder": "Pace & Risk",
            "expression": [
              "// The slice of the monthly target a rep should have hit by today.",
              "// Straight-line by calendar day -- if the business has a known intra-month",
              "// selling curve (e.g. heavier in the last week), replace [Month Pace %] with a",
              "// weighted lookup rather than editing this measure.",
              "[Target Amount] * [Month Pace %]"
            ],
            "formatString": "#,0",
            "lineageTag": "c469bfd9-3891-4f99-9169-b9adba3614a8"
          },
          {
            "name": "Pace % Achievement",
            "description": "Revenue against the pace-adjusted target. 100% = exactly on track for the period.",
            "displayFolder": "Pace & Risk",
            "expression": "DIVIDE ( [Revenue], [Pace-Adjusted Target] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "81b61697-94c5-47ba-a43f-f21386133047"
          },
          {
            "name": "# Reps At Risk",
            "description": "Count of salespeople below 85% pace-adjusted attainment in the selected period.",
            "displayFolder": "Pace & Risk",
            "expression": [
              "// Reps tracking below 85% of where they should be by today.",
              "// Reps with no target at all are excluded rather than counted as failing.",
              "VAR Threshold = 0.85",
              "RETURN",
              "    COUNTROWS (",
              "        FILTER (",
              "            VALUES ( dim_salespersons[salesperson_name] ),",
              "            NOT ISBLANK ( [Target Amount] )",
              "                && [Pace % Achievement] < Threshold",
              "        )",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "68bd34eb-4f17-472c-ab2a-4ca457c6e124"
          },
          {
            "name": "SD Rank (Revenue)",
            "description": "Dense rank of each sub-distributor by sell-out Revenue.",
            "displayFolder": "Ranking",
            "expression": [
              "RANKX (",
              "    ALL ( dim_clientsd[clientsd_name] ),",
              "    [Revenue],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "b54f4fb9-dda7-415c-b6b0-cf90512e0feb"
          },
          {
            "name": "SD Rank (Sell-In Amount)",
            "description": "Dense rank of each sub-distributor by sell-in Amount.",
            "displayFolder": "Ranking",
            "expression": [
              "RANKX (",
              "    ALL ( dim_clientsd[clientsd_name] ),",
              "    [Sell-In Amount],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "eb097513-afc2-4f48-aa96-526d443cd21f"
          },
          {
            "name": "# Sales Lines Missing Client Link",
            "description": "Sell-out lines with a blank or unresolvable clientsd_key.",
            "displayFolder": "Data Quality",
            "expression": [
              "// Sell-out lines that do not resolve to a row in dim_clientsd -- either the key",
              "// is blank in the fact, or it points at an SD that is not in the dimension for",
              "// that sale date (an SCD2 window gap).",
              "//",
              "// Note for the Data Quality page: view this as Sales Director or Data Analyst.",
              "// Under the Sales Rep / Supervisor / Regional Manager roles, RLS filters",
              "// dim_clientsd and the RELATED() test will report rows as unlinked that are",
              "// merely out of scope.",
              "VAR Missing =",
              "    COUNTROWS (",
              "        FILTER (",
              "            fact_sales,",
              "            ISBLANK ( fact_sales[clientsd_key] )",
              "                || ISBLANK ( RELATED ( dim_clientsd[clientsd_key] ) )",
              "        )",
              "    )",
              "RETURN",
              "    COALESCE ( Missing, 0 )"
            ],
            "formatString": "#,0",
            "lineageTag": "8277779d-f333-4208-926f-d954865944a3"
          },
          {
            "name": "Sales Lines Missing Client Link %",
            "description": "Share of sell-out lines with a blank or unresolvable clientsd_key.",
            "displayFolder": "Data Quality",
            "expression": "DIVIDE ( [# Sales Lines Missing Client Link], COUNTROWS ( fact_sales ) )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "20510f24-2b93-422c-905d-27b883a32cb2"
          },
          {
            "name": "Weighted Avg Price Variance %",
            "description": "Quantity-weighted variance of realised price against standard list price.",
            "displayFolder": "Pricing",
            "expression": [
              "// Quantity-weighted by construction: comparing two revenue totals over the same",
              "// rows weights every SKU by the units actually sold, so a 1-unit outlier cannot",
              "// move the number the way an AVERAGE of per-line variances would.",
              "//",
              "// Requires unit_price_standard on fact_sales -- see the Power Query note in",
              "// MODEL_CHANGELOG.md. Returns blank until that column is kept.",
              "VAR ActualRevenue = SUM ( fact_sales[total_amount] )",
              "VAR StandardRevenue =",
              "    SUMX ( fact_sales, fact_sales[quantity] * fact_sales[unit_price_standard] )",
              "RETURN",
              "    DIVIDE ( ActualRevenue - StandardRevenue, StandardRevenue )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "c2ce1090-3c67-4943-9666-ec4c1dfa66c9"
          },
          {
            "name": "# Pricing Exceptions (>10%)",
            "description": "Sell-out lines priced more than 10% away from standard list price.",
            "displayFolder": "Pricing",
            "expression": [
              "// Lines sold more than 10% away from list price in either direction.",
              "// Computed from the two price columns rather than the pre-computed",
              "// price_variance_pct so the threshold is unit-safe (fraction vs. percent",
              "// ambiguity in the source).",
              "COUNTROWS (",
              "    FILTER (",
              "        fact_sales,",
              "        VAR Std = fact_sales[unit_price_standard]",
              "        VAR Act = fact_sales[unit_price_actual]",
              "        RETURN",
              "            NOT ISBLANK ( Std ) && Std <> 0",
              "                && ABS ( DIVIDE ( Act - Std, Std ) ) > 0.10",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "1c31445f-525d-44f9-8c5e-b0e105872efe"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": "Row(\"Column\", BLANK())",
              "type": "calculated"
            }
          }
        ]
      },
      {
        "name": "Time Intelligence",
        "calculationGroup": {
          "calculationItems": [
            {
              "name": "Current",
              "expression": "SELECTEDMEASURE()"
            },
            {
              "name": "MTD",
              "expression": "CALCULATE(SELECTEDMEASURE(), DATESMTD(dim_date[date_actual]))"
            },
            {
              "name": "QTD",
              "expression": [
                "",
                "CALCULATE(",
                "    SELECTEDMEASURE(),",
                "    DATESQTD(dim_date[date_actual])",
                ")"
              ]
            },
            {
              "name": "PM",
              "expression": [
                "",
                "CALCULATE(",
                "    SELECTEDMEASURE(),",
                "    DATEADD(dim_date[date_actual], -1, MONTH)",
                ")"
              ]
            },
            {
              "name": "PY",
              "expression": [
                "",
                "CALCULATE(",
                "    SELECTEDMEASURE(),",
                "    SAMEPERIODLASTYEAR(dim_date[date_actual])",
                ")"
              ]
            },
            {
              "name": "MoM %",
              "expression": [
                "",
                "VAR Cur  = SELECTEDMEASURE()",
                "VAR Prev = CALCULATE(SELECTEDMEASURE(), DATEADD(dim_date[date_actual], -1, MONTH))",
                "RETURN DIVIDE(Cur - Prev, Prev)"
              ],
              "formatStringDefinition": {
                "expression": "IF(SELECTEDMEASURENAME() IN {\"MoM %\", \"YoY %\"}, \"0.0%\", \"#,##0\")"
              }
            },
            {
              "name": "YoY %",
              "expression": [
                "",
                "VAR Cur  = SELECTEDMEASURE()",
                "VAR Prev = CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR(dim_date[date_actual]))",
                "RETURN DIVIDE(Cur - Prev, Prev)"
              ],
              "formatStringDefinition": {
                "expression": "IF(SELECTEDMEASURENAME() IN {\"MoM %\", \"YoY %\"}, \"0.0%\", \"#,##0\")"
              }
            }
          ]
        },

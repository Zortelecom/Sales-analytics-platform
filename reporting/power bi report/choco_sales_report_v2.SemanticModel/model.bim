            "isHidden": true,
            "lineageTag": "99c6f549-99a2-4687-b8a2-a3086f06555e",
            "sourceColumn": "subregion_key"
          },
          {
            "name": "region_conflict",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "dataType": "boolean",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "lineageTag": "6b5ea937-3ebd-4aac-ba58-1b1a71ac2a27",
            "sourceColumn": "region_conflict"
          }
        ],
        "hierarchies": [
          {
            "name": "Geography",
            "levels": [
              {
                "name": "Region",
                "column": "region",
                "lineageTag": "65916970-2bc7-449b-95bb-176309cf48e5",
                "ordinal": 0
              },
              {
                "name": "Subregion",
                "column": "subregion",
                "lineageTag": "c6878bb3-4f26-41f2-b712-38479dd3a6b5",
                "ordinal": 1
              }
            ],
            "lineageTag": "cdcf78ea-3beb-439b-8f22-5b3654d13096"
          }
        ],
        "lineageTag": "f6965ed7-c4bb-41be-b6e4-7c47e9170c86",
        "partitions": [
          {
            "name": "dim_geography",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    // dim_clientsd and dim_salespersons are the only two tables that carry",
                "    // raw region/subregion text today -- this table conforms both into one",
                "    // governed list so region/subregion can be sliced consistently (and so",
                "    // hand-typed casing drift, e.g. \"littoral\" vs \"Littoral\", collapses to one row).",
                "    FromClients = Table.SelectColumns(",
                "        Table.TransformColumns(dim_clientsd, {{\"region\", Text.Trim}, {\"subregion\", Text.Trim}}),",
                "        {\"region\", \"subregion\"}",
                "    ),",
                "    FromSalespersons = Table.SelectColumns(",
                "        Table.TransformColumns(dim_salespersons, {{\"region\", Text.Trim}, {\"subregion\", Text.Trim}}),",
                "        {\"region\", \"subregion\"}",
                "    ),",
                "    Combined = Table.Combine({FromClients, FromSalespersons}),",
                "",
                "    // Canonical display casing -- same idea as the product_category Text.Trim bridge,",
                "    // extended to Text.Proper since region/subregion casing drifts more than category does.",
                "    Proper = Table.TransformColumns(Combined, {{\"region\", Text.Proper}, {\"subregion\", Text.Proper}}),",
                "",
                "    // Join key back to dim_clientsd[subregion_key] / dim_salespersons[subregion_key]:",
                "    // TRIM(UPPER(...)) mirrors the SKU-matching normalization already used in the",
                "    // SQLMesh staging layer, applied here to keep both platforms consistent.",
                "    WithKey = Table.AddColumn(Proper, \"subregion_key\", each Text.Upper(Text.Trim([subregion])), type text),",
                "",
                "    // Group so subregion_key is guaranteed unique (Power BI requires a unique key on the",
                "    // \"one\" side of a relationship). Assumes each subregion belongs to exactly one region --",
                "    // verify against real data (see build checklist). If a supervisor ever hand-types the same",
                "    // subregion under two different regions, this concatenates both region names into one",
                "    // display value and flags region_conflict = TRUE instead of silently picking one --",
                "    // that conflict should surface on the Data Quality page, not disappear here.",
                "    Grouped = Table.Group(WithKey, {\"subregion_key\"}, {",
                "        {\"region\", each Text.Combine(List.Distinct([region]), \" / \"), type text},",
                "        {\"subregion\", each [subregion]{0}, type text},",
                "        {\"region_conflict\", each List.Count(List.Distinct([region])) > 1, type logical}",
                "    }),",
                "",
                "    Sorted = Table.Sort(Grouped, {{\"region\", Order.Ascending}, {\"subregion\", Order.Ascending}})",
                "in",
                "    Sorted"
              ],
              "type": "m"
            }
          }
        ]
      },
      {

{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.114.json",
  "name": "Chococam Distribution Analytics",
  "dataColors": [
    "#6B3E1F",
    "#C59348",
    "#2E6E8E",
    "#7D5BA6",
    "#0F4C5C",
    "#B07AA1",
    "#8C8279",
    "#3D3D3D"
  ],
  "good": "#276B2A",
  "neutral": "#8F5300",
  "bad": "#B3261E",
  "maximum": "#276B2A",
  "center": "#F5F1EC",
  "minimum": "#B3261E",
  "null": "#8C8279",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F1EC",
  "backgroundNeutral": "#E8E3DE",
  "foreground": "#1F1512",
  "foregroundNeutralSecondary": "#5C534D",
  "foregroundNeutralTertiary": "#7A6E64",
  "tableAccent": "#6B3E1F",
  "hyperlink": "#2E6E8E",
  "secondaryBackground": "#F5F1EC",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#1F1512"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1F1512"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#1F1512"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#5C534D"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "responsive": true,
            "wordWrap": true
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E8E3DE"
              }
            },
            "radius": 4
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#7A6E64"
              }
            },
            "showVisualInformationButton": true,
            "transparency": 0
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#1F1512"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alignment": "left",
            "titleWrap": true
          }
        ],
        "subTitle": [
          {
            "show": false,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#7A6E64"
              }
            },
            "alignment": "left"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5C534D"
              }
            },
            "gridlineShow": false,
            "showAxisTitle": false,
            "lineColor": {
              "solid": {
                "color": "#E8E3DE"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#7A6E64"
              }
            },
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EFEAE5"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "solid",
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "showTitle": false,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5C534D"
              }
            }
          }
        ],
        "labels": [
          {
            "show": false,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#5C534D"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F1EC"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F1EC"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 28,
            "color": {
              "solid": {
                "color": "#1F1512"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#5C534D"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E8E3DE"
              }
            },
            "radius": 4
          }
        ]
      }
    },
    "kpi": {
      "*": {
        "indicator": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 28,
            "color": {
              "solid": {
                "color": "#1F1512"
              }
            }
          }
        ],
        "trendline": [
          {
            "show": true,
            "transparency": 70
          }
        ],
        "goals": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#5C534D"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E8E3DE"
              }
            },
            "radius": 4
          }
        ],
        "header": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#1F1512"
              }
            },
            "outline": "None"
          }
        ],
        "items": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#1F1512"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "selection": [
          {
            "singleSelect": false,
            "strictSingleSelect": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EFEAE5"
              }
            },
            "gridHorizontalWeight": 1,
            "outlineColor": {
              "solid": {
                "color": "#E8E3DE"
              }
            },
            "outlineWeight": 1,
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#1F1512"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F5F1EC"
              }
            },
            "wordWrap": true,
            "alignment": "Left"
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#1F1512"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FCFAF8"
              }
            },
            "banded": true
          }
        ],
        "total": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#1F1512"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F5F1EC"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EFEAE5"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#E8E3DE"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#1F1512"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F5F1EC"
              }
            },
            "wordWrap": true
          }
        ],
        "rowHeaders": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#1F1512"
              }
            },
            "steppedLayoutIndentation": 15
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#1F1512"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FCFAF8"
              }
            },
            "banded": true
          }
        ],
        "subTotals": [
          {
            "rowSubtotals": true,
            "columnSubtotals": false,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#1F1512"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "labels": [
          {
            "show": false
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 2,
            "lineStyle": "solid"
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "valueAxis": [
          {
            "gridlineShow": false
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#5C534D"
              }
            }
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#DC2427"
              }
            },
            "transparency": 0,
            "$id": "default"
          },
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#B31D20"
              }
            },
            "transparency": 0,
            "$id": "hover"
          }
        ],
        "text": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "$id": "default"
          }
        ],
        "outline": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "*": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ]
      }
    },
    "shape": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "outline": [
          {
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#E8E3DE"
              }
            },
            "weight": 1
          }
        ]
      }
    }
  }
}